                  "id": "http://vocab.getty.edu/aat/300417207",
                  "type": "Type"
                }
              ],
              "content": "Gezicht op de herberg Huis Te Vraag aan de Sloterweg",
              "language": [
                {
                  "id": "http://vocab.getty.edu/aat/300388256",
                  "type": "Language"
                }
              ]
