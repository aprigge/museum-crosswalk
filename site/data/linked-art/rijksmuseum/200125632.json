                  "type": "Type"
                },
                {
                  "id": "http://vocab.getty.edu/aat/300417207",
                  "type": "Type"
                }
              ],
              "content": "Pieter Haringh (‘Jonge Haringh’)",
              "language": [
                {
                  "id": "http://vocab.getty.edu/aat/300388256",
                  "type": "Language"
                }
              ]
            }
