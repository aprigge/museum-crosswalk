                },
                {
                  "id": "http://vocab.getty.edu/aat/300417207",
                  "type": "Type"
                }
              ],
              "content": "Boerenhuis verscholen tussen de bomen",
              "language": [
                {
                  "id": "http://vocab.getty.edu/aat/300388256",
