      "part": [
        {
          "type": "LinguisticObject",
          "classified_as": [
            {
              "id": "http://vocab.getty.edu/aat/300048722",
              "type": "Type"
            }
          ],
          "content": "These baskets made of willow branches and resting on sticks were intended to offer shelter to nesting ducks. In the past, their eggs were gathered for consumption. In contrast to his mills and panoramic views, Gabriël here ‘zooms in’ on a detail in nature. He thus presents an unusual perspective of the watery Dutch landscape from a low vantage point on the embankment."
        },
        {
          "type": "LinguisticObject",
          "classified_as": [
            {
              "id": "http://vocab.getty.edu/aat/300312075",
              "type": "Type"
            }
