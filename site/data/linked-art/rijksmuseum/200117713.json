                },
                {
                  "id": "http://vocab.getty.edu/aat/300417207",
                  "type": "Type"
                }
              ],
              "content": "Een van de drie koningen aanbidt Maria en het kind",
              "language": [
                {
                  "id": "http://vocab.getty.edu/aat/300388256",
                  "type": "Language"
                }
              ]
            }
