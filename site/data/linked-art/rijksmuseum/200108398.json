      "part": [
        {
          "type": "LinguisticObject",
          "classified_as": [
            {
              "id": "http://vocab.getty.edu/aat/300048722",
              "type": "Type"
            }
          ],
          "content": "A tranquil landscape executed in bright colours: this early painting by Weissenbruch is still very Romantic in feel. Yet unlike the Romantic painters, Weissenbruch did not alter reality to suit his imagination, but gave a topographically accurate representation. The Trekvliet Canal linked The Hague with the neighbouring villages of Rijswijk and Voorburg. In the distance at left is the tower of De Binckhorst Castle, and the windmill called the Laakmolen at right."
        },
        {
          "type": "LinguisticObject",
          "classified_as": [
            {
              "id": "http://vocab.getty.edu/aat/300312075",
              "type": "Type"
            }
          ],
