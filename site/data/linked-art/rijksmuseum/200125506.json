          ],
          "content": "Buiten Amsterdam stonden zes van dit soort palen, ter markering  van de stadsgrenzen. Deze paal stond aan de Spaarndammerdijk, tussen Amsterdam en Haarlem. Rembrandt etste in eerste instantie de banpaal in zijn geheel, maar zette hier later een groot deel overheen. Wanneer je goed kijkt, is de eerste poging nog steeds zichtbaar."
        },
        {
          "type": "LinguisticObject",
          "classified_as": [
            {
              "id": "http://vocab.getty.edu/aat/300312075",
              "type": "Type"
            }
          ],
          "part": [
            {
              "type": "LinguisticObject",
              "content": "ets en droge naald, met lichte plaattoon, ca. 1650"
            },
            {
              "id": "_:bnode0",
              "type": "Name",
              "classified_as": [
                {
                  "id": "http://vocab.getty.edu/aat/300404670",
                  "type": "Type"
                },
                {
                  "id": "http://vocab.getty.edu/aat/300417207",
                  "type": "Type"
                }
              ],
              "content": "Boerenhuis en banpaal aan de Spaarndammerdijk",
              "language": [
                {
                  "id": "http://vocab.getty.edu/aat/300388256",
                  "type": "Language"
                }
              ]
            }
          ]
        }
