                  "type": "Type"
                },
                {
                  "id": "http://vocab.getty.edu/aat/300417207",
                  "type": "Type"
                }
              ],
              "content": "Oude man met lange baard, bontmuts en fluwelen mantel",
              "language": [
                {
                  "id": "http://vocab.getty.edu/aat/300388256",
                  "type": "Language"
                }
              ]
