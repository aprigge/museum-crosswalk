    {
      "type": "LinguisticObject",
      "content": "Winslow Homer observed the shoreline in various weather conditions and seasons after moving to live in near isolation in Prouts Neck, Maine, in 1883. Amid the remote and dramatic landscape, he depicted seascapes void of human life, focusing instead on an emotional response to nature. His marine scenes, larger than his earlier works, emphasize the vastness and power of the sea.",
      "classified_as": [
        {
          "id": "http://vocab.getty.edu/aat/300026032",
          "type": "Type",
          "_label": "Summary",
          "classified_as": [
            {
              "id": "http://vocab.getty.edu/aat/300418049",
              "type": "Type",
              "_label": "Brief Text"
            }
          ]
        }
      ]
    },
    {
      "type": "LinguisticObject",
      "content": "<p>Winslow Homer observed the shoreline in various weather conditions and seasons after moving to live in near isolation in Prouts Neck, Maine, in 1883. Amid the remote and dramatic landscape, he depicted seascapes void of human life, focusing instead on an emotional response to nature. His marine scenes are larger than his earlier works, the size of the canvases emphasize the vastness and power of the sea. Homer alluded to the violence of water through the sharply diagonal shoreline and vigorous brushwork. The flat areas of color that he employed to represent the rugged rocks simultaneously hint at abstraction.</p>\n",
      "classified_as": [
        {
          "id": "http://vocab.getty.edu/aat/300435416",
          "type": "Type",
          "_label": "Description",
          "classified_as": [
            {
              "id": "http://vocab.getty.edu/aat/300418049",
              "type": "Type",
              "_label": "Brief Text"
            }
          ]
        }
      ],
      "format": "text/html"
    }
