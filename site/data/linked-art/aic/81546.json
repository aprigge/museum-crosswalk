    {
      "type": "LinguisticObject",
      "content": "Potter Palmer, (d. 1902) Chicago [per Wildenstein 1996; Tucker 1989, p. 55 suggests that the painting was purchased by Berthe Palmer, not Potter Palmer]; by descent to the Potter Family, Chicago; given to the Art Institute of Chicago, 1922.",
      "classified_as": [
