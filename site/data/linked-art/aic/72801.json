    {
      "type": "LinguisticObject",
      "content": "Signed recto, bottom-right, on snowy ground, in grey paint: \"J. H. TWACHTMAN\".",
      "classified_as": [
        {
          "id": "http://vocab.getty.edu/aat/300435414",
