    {
      "type": "LinguisticObject",
      "content": "Inscribed lower left: Jules Breton / Courrieres 1884",
      "classified_as": [
        {
          "id": "http://vocab.getty.edu/aat/300435414",
          "type": "Type",
          "_label": "Inscription Statement",
          "classified_as": [
