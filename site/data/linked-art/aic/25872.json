    {
      "type": "LinguisticObject",
      "content": "Alexander Morton, New York, by 1916; American Art Galleries, New York, 1916; Macbeth Galleries, New York, 1916; sold to Martin A. Ryerson (1856–1932), Chicago, 1916; by descent to his wife Carrie Hutchinson Ryerson (1859–1937), Chicago, 1932 [<em>Last Will and Testament of Martin A. Ryerson, Died August 11, 1932</em>, copy in Institutional Archives, Art Institute of Chicago]; bequeathed to the Art Institute of Chicago, 1937.",
      "classified_as": [
        {
          "id": "http://vocab.getty.edu/aat/300435438",
          "type": "Type",
          "_label": "Provenance Statement",
          "classified_as": [
            {
              "id": "http://vocab.getty.edu/aat/300418049",
              "type": "Type",
              "_label": "Brief Text"
            }
          ]
        }
      ]
    },
    {
      "type": "LinguisticObject",
      "content": "<em>The White Bridge</em> depicts a brook that traversed John Henry Twachtman's Connecticut property. The artist painted at least six versions of the bridge over six years, changing its shape slightly in each work. Twachtman may have altered the actual bridge or simply changed its appearance in each painting. Loosely rendered with feathery brushstrokes, and incorporating expanses of unprimed canvas, this scene captures the verdant blossoming of spring.",
      "classified_as": [
        {
          "id": "http://vocab.getty.edu/aat/300026032",
          "type": "Type",
          "_label": "Summary",
          "classified_as": [
            {
              "id": "http://vocab.getty.edu/aat/300418049",
              "type": "Type",
              "_label": "Brief Text"
            }
          ]
        }
      ]
    },
    {
      "type": "LinguisticObject",
      "content": "<p><em>The White Bridge</em> depicts Horseneck Brook, which traversed John Henry Twachtman's Connecticut property. The artist painted at least six versions of the bridge over the course of six years; however, its shape is slightly different in each work. Twachtman may have altered the actual bridge or simply changed its appearance in each painting. Loosely rendered with feathery brushstrokes of green and rich brown, and incorporating expanses of unprimed canvas, this scene captures the rapid growth and verdant blossoming of spring.</p>\n",
      "classified_as": [
        {
          "id": "http://vocab.getty.edu/aat/300435416",
          "type": "Type",
          "_label": "Description",
          "classified_as": [
