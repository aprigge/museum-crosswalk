    {
      "type": "LinguisticObject",
      "content": "Coleman Sellers and Sophonisba Peale Sellers; by descent in the family to mary Morley Sellers; bequested to the Art Institute of Chicago, 1940.",
      "classified_as": [
        {
          "id": "http://vocab.getty.edu/aat/300435438",
          "type": "Type",
