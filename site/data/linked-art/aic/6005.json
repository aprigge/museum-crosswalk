    {
      "type": "LinguisticObject",
      "content": "Inscribed lower right: C. Pissarro 1866",
      "classified_as": [
        {
          "id": "http://vocab.getty.edu/aat/300435414",
          "type": "Type",
          "_label": "Inscription Statement",
          "classified_as": [
