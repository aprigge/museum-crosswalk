{
  "name": "museum-crosswalk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Harvester prototype: how well open museum data lines up, one artist at a time.",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "harvest": "tsx --env-file-if-exists=.env src/cli/harvest.ts",
    "transform": "tsx --env-file-if-exists=.env src/cli/transform.ts",
    "reconcile": "tsx --env-file-if-exists=.env src/cli/reconcile.ts",
    "report": "tsx --env-file-if-exists=.env src/cli/report.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "concepts": "tsx --env-file-if-exists=.env src/cli/concepts.ts",
    "graph": "tsx --env-file-if-exists=.env src/cli/graph.ts",
    "query": "tsx --env-file-if-exists=.env src/cli/query.ts",
    "index": "tsx --env-file-if-exists=.env src/cli/index.ts",
    "evaluate": "tsx --env-file-if-exists=.env src/cli/evaluate.ts",
    "site": "tsx --env-file-if-exists=.env src/cli/site.ts",
    "eval": "tsx --env-file-if-exists=.env src/cli/eval.ts",
    "vocabulary": "tsx --env-file-if-exists=.env src/cli/vocabulary.ts",
    "enrich": "tsx --env-file-if-exists=.env src/cli/enrich.ts",
    "review-assist": "tsx --env-file-if-exists=.env src/cli/review-assist.ts",
    "review": "tsx --env-file-if-exists=.env src/cli/review.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.11.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "jsonld": "^9.0.0",
    "minisearch": "^7.2.0",
    "oxigraph": "^0.5.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/jsonld": "^1.5.15",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
