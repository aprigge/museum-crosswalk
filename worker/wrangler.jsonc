// The "Ask the graph" proxy: holds the Anthropic key so the static site doesn't have to.
// Local: `npm run worker:dev` (key from worker/.dev.vars). Deploy: see README "Ask the graph".
{
  "name": "museum-crosswalk-ask",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    // Pages that may call this Worker (CORS). Localhost is for testing the site locally.
    "ALLOWED_ORIGINS": "https://aprigge.github.io,http://127.0.0.1:8765,http://localhost:8765",
    // A ceiling on questions per day across all visitors: a spending cap (approximate; KV is eventually consistent).
    "DAILY_CAP": "300"
  },
  // Per visitor: 5 questions per minute in each Cloudflare location (approximate, per the binding's docs).
  "ratelimits": [
    { "name": "ASK_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
  ],
  // Daily counter, provisioned by the first deploy. Local dev uses a local namespace.
  "kv_namespaces": [{ "binding": "ASK_COUNTS", "id": "75e06fab8d0449c1a54aee94fda2576f" }]
  // ANTHROPIC_API_KEY is a secret: `npx wrangler secret put ANTHROPIC_API_KEY --config worker/wrangler.jsonc`.
  // Until it is set, the Worker answers "Asking the model failed".
}
